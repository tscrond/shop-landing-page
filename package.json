{
  "name": "shop-landing-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:frontend",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:build": "run-p type-check \"build-only {@}\" -- && npm --prefix backend run build",
    "build": "run-p type-check \"build-only {@}\" -- && npm --prefix backend run build",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "format": "prettier --write src/",
    "backend:install": "npm --prefix backend install"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.1",
    "@tailwindcss/vite": "^4.1.11",
    "motion": "^12.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.5.3",
    "typescript": "~5.8.0",
    "vite": "^7.0.0"
  }
}
